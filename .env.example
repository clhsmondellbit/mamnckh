# AI provider - all secrets stay server-side. Do not use NEXT_PUBLIC_ for secrets.
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
AI_MODEL=qwen/qwen3-30b-a3b:free
SAFETY_MODEL=nvidia/nemotron-3.5-content-safety:free

# Public school identity / AI escalation wording only.
# This JSON is NOT the public School Support Center directory.
# Publish real contacts only through the verified staff directory in the database.
NEXT_PUBLIC_SCHOOL_NAME=
SCHOOL_SUPPORT_CONFIG_JSON=
SCHOOL_ESCALATION_INSTRUCTIONS=
SCHOOL_SUPPORT_LAST_VERIFIED_AT=

# Staff dashboard and private support requests require all four values below.
ENABLE_STAFF_DASHBOARD=false
DATABASE_URL=
AUTH_SECRET=
# 32 random bytes, Base64-encoded. Protect/backup securely: losing it prevents decrypting active support requests.
DATA_ENCRYPTION_KEY=
# Secret used by the trusted daily scheduler for POST /api/cron/purge-support-data
CRON_SECRET=

# Exact public origin; use HTTPS in production and do not include a path.
APP_URL=http://localhost:3000

# One-time bootstrap only (do not keep these values in a long-lived .env file):
# STAFF_BOOTSTRAP_EMAIL=
# STAFF_BOOTSTRAP_NAME=
# STAFF_BOOTSTRAP_PASSWORD=  # minimum 16 characters
