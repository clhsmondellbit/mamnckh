# AI provider: keep all keys on the server. Never add NEXT_PUBLIC_ to a secret.
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
AI_MODEL=qwen/qwen3-30b-a3b:free
SAFETY_MODEL=nvidia/nemotron-3.5-content-safety:free

# School support: use only verified, real data. This can be a one-line JSON
# value based on config/school-support.example.json. Leave blank until verified.
NEXT_PUBLIC_SCHOOL_NAME=
SCHOOL_SUPPORT_CONFIG_JSON=
SCHOOL_ESCALATION_INSTRUCTIONS=
SCHOOL_SUPPORT_LAST_VERIFIED_AT=

# Optional voluntary handoff and protected staff dashboard.
# These must all be configured together; the feature fails closed otherwise.
DATABASE_URL=
AUTH_SECRET=
STAFF_PASSWORD=
ENABLE_STAFF_DASHBOARD=false

APP_URL=http://localhost:3000
